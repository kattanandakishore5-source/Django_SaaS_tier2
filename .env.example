# Django Starter — Environment Configuration
# Copy this file to .env and fill in your values.
# ================================================

# Core
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (defaults to SQLite if not set)
# DATABASE_URL=postgres://user:pass@localhost:5432/dbname

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Set to True to run Celery tasks synchronously without a Redis broker.
# This is convenient for local development but must be False in production.
CELERY_TASK_ALWAYS_EAGER=True

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Stripe (billing)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000
